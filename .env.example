# Local development defaults only. Never reuse these values in production.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGRES_PASSWORD=postgres
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Client base URL used in links sent by email (no trailing slash).
APP_URL=http://localhost:5173
# Browser-side API base URL; the API enforces CORS for http://localhost:5173
# and accepts the Authorization header for Bearer tokens.
VITE_API_URL=http://localhost:3000

# HS256 signing secret for access tokens (24-hour expiry). This value is a
# LOCAL DEVELOPMENT DEFAULT ONLY. Set a long random value in production; the
# API refuses to start with NODE_ENV=production and no JWT_SECRET.
JWT_SECRET=local-development-only-change-me

# Email provider selection. Leave unset to use mailtrap in development/test
# and resend when NODE_ENV=production. With no credentials for the selected
# provider the console fallback prints the message and a warning.
EMAIL_PROVIDER=mailtrap
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASSWORD=
MAILTRAP_FROM=no-reply@example.com
RESEND_API_KEY=
RESEND_FROM=
