# Local development defaults only. Never reuse these values in production.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGRES_PASSWORD=postgres
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Grafana MCP: each developer creates a token in their local Grafana instance.
GRAFANA_URL=http://localhost:3002
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Hosted Postgres (Prisma): copy the real values from your provider into .env,
# replacing the local DATABASE_URL above. Never put real credentials here: this
# file is tracked by Git. DATABASE_URL is the direct URL used by the API and
# drizzle-kit; DATABASE_URL_POOLED is the pooled host; POSTGRES_URL and
# PRISMA_DATABASE_URL are aliases exported by the provider's console.
DATABASE_URL_POOLED=postgres://USER:PASSWORD@pooled.example.com:5432/postgres?sslmode=require
POSTGRES_URL=postgres://USER:PASSWORD@db.example.com:5432/postgres?sslmode=require
PRISMA_DATABASE_URL=postgres://USER:PASSWORD@db.example.com:5432/postgres?sslmode=require

# Client base URL used in links sent by email (no trailing slash).
APP_URL=http://localhost:5173
# Browser-side API base URL; the API enforces CORS for http://localhost:5173
# and accepts the Authorization header for Bearer tokens.
VITE_API_URL=http://localhost:3000

# HS256 signing secret for access tokens (24-hour expiry). This value is a
# LOCAL DEVELOPMENT DEFAULT ONLY. Set a long random value in production; the
# API refuses to start with NODE_ENV=production and no JWT_SECRET.
JWT_SECRET=local-development-only-change-me

# Email provider selection. Leave unset to use mailtrap in development/test
# and resend when NODE_ENV=production. With no credentials for the selected
# provider the console fallback prints the message and a warning.
EMAIL_PROVIDER=mailtrap
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASSWORD=
MAILTRAP_FROM=no-reply@example.com
RESEND_API_KEY=
RESEND_FROM=

# API observability (local development). Supply these to the API process as well
# as Compose when customizing; the API ConfigModule reads its current .env.
OBSERVABILITY_ENABLED=true
METRICS_PORT=9464
METRICS_HOST=0.0.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_INSTANCE_ID=local-api
