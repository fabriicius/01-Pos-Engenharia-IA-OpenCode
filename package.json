{
  "name": "coders-module-4-fabricius",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "types:check": "turbo run check-types",
    "code:fix": "turbo run code:fix",
    "test": "turbo run test",
    "infra:up": "supabase start && docker compose up -d",
    "infra:down": "supabase stop && docker compose down",
    "db:migrate": "drizzle-kit migrate",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@babel/plugin-syntax-decorators": "8.0.1",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@repo/eslint-config": "*",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "eslint": "10.9.1",
    "lefthook": "2.2.2",
    "lint-staged": "17.6.2",
    "pg": "8.23.1",
    "prettier": "3.9.6",
    "supabase": "3.3.0",
    "supertest": "7.3.2",
    "turbo": "^2.11.13",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "9.2.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
